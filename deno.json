{
  "name": "@yano3nora/excel2json",
  "version": "0.0.3",
  "exports": "./main.ts",
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/package/xlsx.mjs",
    "tsutils": "https://deno.land/x/yano3nora_tsutils@v0.29.0/main.ts"
  },
  "tasks": {
    "dev": "deno test -A --watch",
    "main": "deno run --allow-read --allow-write main.ts",
    "check": "deno fmt --check && deno lint && deno check --allow-import=cdn.sheetjs.com,deno.land,jsr.io main.ts mods.ts scripts/release.ts",
    "test": "deno test --allow-read --allow-import=cdn.sheetjs.com,deno.land,jsr.io",
    "compile": "deno compile --allow-read --allow-write --allow-import=cdn.sheetjs.com,deno.land,jsr.io --output excel2json main.ts"
  },
  "fmt": {
    "include": [
      "main.ts",
      "mods.ts",
      "mods.test.ts",
      "scripts/"
    ],
    "singleQuote": true,
    "semiColons": false
  }
}
